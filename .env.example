# --- Datastore ---------------------------------------------------------------
# Plain postgresql:// is fine — the app normalises it to the psycopg3 driver.
# For Neon, use the POOLED connection string (…-pooler…) with sslmode=require.
DATABASE_URL=postgresql://ragchat:ragchat@localhost:5432/ragchat

# --- Providers (Phase 1: your shared keys) -----------------------------------
COHERE_API_KEY=your_cohere_api_key
GOOGLE_API_KEY=your_gemini_api_key

# --- Model / retrieval (defaults shown) --------------------------------------
# EMBEDDING_MODEL=embed-english-v3.0
# EMBEDDING_DIMENSION=1024
# LLM_MODEL=gemini-flash-lite-latest  # lite alias: most generous free quota, tracks current model
# LLM_TEMPERATURE=0.0
# RETRIEVER_K=3

# --- Multi-tenancy / lifecycle -----------------------------------------------
# SESSION_TTL_HOURS=24

# --- Upload limits -----------------------------------------------------------
# MAX_UPLOAD_BYTES=2097152          # 2 MiB
# MAX_SECTIONS_PER_UPLOAD=150
# CHUNK_MAX_CHARS=1200
# CHUNK_OVERLAP_CHARS=150

# --- Rate limiting & cost control --------------------------------------------
# RATE_LIMIT_ASKS_PER_MINUTE=10      # per-session burst; kept under the Gemini free-tier RPM
# RATE_LIMIT_INGESTS_PER_HOUR=20
# DAILY_REQUEST_BUDGET=1000          # instance-wide shared-key asks/day (0 = unlimited)
# DAILY_FREE_ALLOWANCE=10            # free shared-key asks/day per user before BYO keys (0 = unlimited)
# USAGE_HASH_SALT=change-me-in-prod  # salt for hashing client IPs in usage counters
# TRUSTED_PROXY_HOPS=1               # reverse-proxy hops in front of the app (Render = 1)

# --- Observability -----------------------------------------------------------
# LOG_LEVEL=INFO
